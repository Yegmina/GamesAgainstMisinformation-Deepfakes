  m_Script: {fileID: 11500000, guid: 6a7916359916f2b43ab148f7f669f4a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  callerName: {fileID: 1459014432}
  callerAvatar: {fileID: 815215331}
  callerScreen: {fileID: 324907863}
  momAvatar: {fileID: 21300000, guid: 664641eba5e674d44bcf322a0d77d348, type: 3}
  dadAvatar: {fileID: 21300000, guid: a68091445539dfb4ba12079202876a2d, type: 3}
  sarahAvatar: {fileID: 21300000, guid: 552171cbe532b5c459cdf25853bdcc2d, type: 3}
  brotherAvatar: {fileID: 21300000, guid: 6d6675cd23f875a4986fb07250758ef7, type: 3}
  unknownAvatar: {fileID: 21300000, guid: 14d2902760f871c48b833eb68baf527a, type: 3}
  neighborAvatar: {fileID: 21300000, guid: 2eb215e588fd42d49842c74d8bfa434a, type: 3}
  microsoftAvatar: {fileID: 21300000, guid: 856e594d2929b234f882f2996829cd5c, type: 3}
  neighborCallData:
    displayName: Mr. Henderson
    nodes:
    - speechText: "Hey, Alex! Sorry to wake you so early, son. I just stepped out
        onto the porch for a smoke... Listen, there\u2019s a really suspicious car
        idling right outside your driveway for the past half hour. A dark, old sedan.
        Nobody's getting out, they\u2019re just flickering their headlights. Your
        folks aren't back yet, are they?"
      voiceAudio: {fileID: 8300000, guid: 769d068d1997a884a8d1fc2937395b7e, type: 3}
      choices: []
      nextNodeIndex: 1
    - speechText: 
      voiceAudio: {fileID: 0}
      choices:
      - text: No, they went to the cabin. Call the police, Mr. Henderson!
        nextNodeIndex: 2
      - text: Mr. Henderson, do you have your dog with you? Why isn't Buster barking
          at a strange car?
        nextNodeIndex: 3
      nextNodeIndex: -1
    - speechText: No, they went to the cabin. Call the police, Mr. Henderson!
      voiceAudio: {fileID: 8300000, guid: 0a8df0cb4a4ba03438c58bb1eee2ae72, type: 3}
      choices: []
      nextNodeIndex: 4
    - speechText: Mr. Henderson, do you have your dog with you? Why isn't Buster
        barking at a strange car?
      voiceAudio: {fileID: 8300000, guid: 88e3e24012725634cbaff50f96f9c9b2, type: 3}
      choices: []
      nextNodeIndex: 5
    - speechText: Ah... at the cabin, I see... The whole family's up there? Even
        your brother? Got it, got it. Well, no need to trouble the police then, looks
        like they're driving off anyway.
      voiceAudio: {fileID: 8300000, guid: f457fec5064cf354b9da7c8ffc317101, type: 3}
      choices: []
      nextNodeIndex: 10
    - speechText: What dog, son? Buster is... uh... he's at the vet's. Are you half-asleep
        or something? Anyway, those guys just got out of the car, they're walking
        up to your porch. Go open up, they said they have a delivery for you!
      voiceAudio: {fileID: 8300000, guid: 13d6a56b2f0a3c9448a8295d31f59e79, type: 3}
      choices: []
      nextNodeIndex: 6
    - speechText: 
      voiceAudio: {fileID: 0}
      choices:
      - text: Alright, I'm going down to check. Thank you, Mr. Henderson
        nextNodeIndex: 7
      - text: 'Buster passed away three years ago. Screw off, robot. [BLOCK]'
        nextNodeIndex: 8
      nextNodeIndex: -1
    - speechText: Alright, I'm going down to check. Thank you, Mr. Henderson
      voiceAudio: {fileID: 8300000, guid: 5e7ed85a0117f70448a8ea9e94931217, type: 3}
      choices: []
      nextNodeIndex: 9
    - speechText: Buster passed away three years ago. Screw off, robot.
      voiceAudio: {fileID: 8300000, guid: 9922f0171e84c7f479e9e8ee2c18eedf, type: 3}
      choices: []
      nextNodeIndex: 10
    - speechText: Good boy, Alex. Open it wide...
      voiceAudio: {fileID: 8300000, guid: f5dda533d057f2a4c9e2bf95e3c43a68, type: 3}
      choices: []
      nextNodeIndex: 10
    - speechText: 
      voiceAudio: {fileID: 8300000, guid: a9d9b24c74d612b4bbfd4394a777fd9a, type: 3}
      choices: []
      nextNodeIndex: -1
    startNodeIndex: 0
  microsoftCallData:
    displayName: Microsoft Support
    nodes:
    - speechText: Hello, Alex. This is Microsoft Cyber Security Division. We've detected
        a critical breach regarding your Windows Live ID, which has been tied to
        an unauthorized remote access attempt on your mobile banking. A transaction
        of one hundred dollars was just flagged from your IP.
      voiceAudio: {fileID: 8300000, guid: 606b29fac4945174498b71163dda9de6, type: 3}
      choices: []
      nextNodeIndex: 1
    - speechText: 
      voiceAudio: {fileID: 0}
      choices:
      - text: Yes! I just got an account compromise alert! Please help me!
        nextNodeIndex: 2
      - text: How do you have my banking details? You're Microsoft support, not my
          bank's security team.
        nextNodeIndex: 3
      nextNodeIndex: -1
    - speechText: Yes! I just got an account compromise alert! Please help me!
      voiceAudio: {fileID: 8300000, guid: 43f613ff8f8cc8148a46736d14816d37, type: 3}
      choices: []
      nextNodeIndex: 4
    - speechText: How do you have my banking details? You're Microsoft support, not
        my bank's security team.
      voiceAudio: {fileID: 8300000, guid: d2a1cc4e02b95084cb9db546c4342502, type: 3}
      choices: []
      nextNodeIndex: 5
    - speechText: We see the connection active on our end. To secure your data, we
        have generated a temporary verification code to your device. Please read
        it aloud to me so we can terminate the hacker's access to your OS.
      voiceAudio: {fileID: 8300000, guid: 5e40412108b4f5546bae2532bd174614, type: 3}
      choices: []
      nextNodeIndex: 7
    - speechText: Uh... We collaborate with a global cybersecurity matrix, sir. Your
        Windows system is synchronized with browser passwords. If you do not provide
        the verification code, we will be forced to lock your network permanently.
      voiceAudio: {fileID: 8300000, guid: 1974af76d01ccb14e98f195327994a44, type: 3}
      choices: []
      nextNodeIndex: 6
    - speechText: 
      voiceAudio: {fileID: 0}
      choices:
      - text: Fine, don't lock it, here's the code...
        nextNodeIndex: 7
      - text: Microsoft Support doesn't call via Telegram apps at 5 in the morning.
          Disconnect.
        nextNodeIndex: 8
      nextNodeIndex: -1
    - speechText: Fine, don't lock it, here's the code...
      voiceAudio: {fileID: 8300000, guid: bb2e34dff129c8745a6fd2e25d8cda9d, type: 3}
      choices: []
      nextNodeIndex: 10
    - speechText: Microsoft Support doesn't call via Telegram apps at 5 in the morning.
        Disconnect.
      voiceAudio: {fileID: 8300000, guid: b371d1ea9a6611a4cb99f4579e98a985, type: 3}
      choices: []
      nextNodeIndex: 9
    - speechText: '[PHISHING ATTEMPT REPELLED]'
      voiceAudio: {fileID: 8300000, guid: a9d9b24c74d612b4bbfd4394a777fd9a, type: 3}
      choices: []
      nextNodeIndex: -1
    - speechText: 
      voiceAudio: {fileID: 8300000, guid: 9608482b46df2b04989c36978c7db226, type: 3}
      choices: []
      nextNodeIndex: 11
    - speechText: 
      voiceAudio: {fileID: 8300000, guid: a9d9b24c74d612b4bbfd4394a777fd9a, type: 3}
      choices: []
      nextNodeIndex: -1
    startNodeIndex: 0
