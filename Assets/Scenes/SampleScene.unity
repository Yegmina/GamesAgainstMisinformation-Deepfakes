      m_Calls: []
  m_text: "An <b>audio deepfake</b> (also called <i>voice cloning</i> or a synthetic
    voice) is artificial speech created with deep learning to imitate a specific
    person's voice. By training on recordings of a target, modern systems can produce
    new sentences the person never actually said \u2013 often with convincing tone,
    accent and emotion."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
